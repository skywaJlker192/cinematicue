# Порт backend сервера
APP_PORT=3001

# Режим работы (development/production)
NODE_ENV=development

# Секретный ключ для JWT (ЗАМЕНИТЬ В ПРОДАКШЕНЕ!)
JWT_SECRET=change_me_in_real_project

# CORS настройки
CORS_ORIGIN=http://localhost:3001

# Путь к базе данных
DB_PATH=./backend/db.json

# Тестовый пользователь (только для разработки)
TEST_USER_EMAIL=test@mail.ru
TEST_USER_PASSWORD=123456
